# DevTrack configuration.
# Copy this file to `.env` in the repository root to override defaults.
# Every value shown is the default, so the app also runs with no .env file at all.
# This file must never contain secrets; DevTrack does not need any API keys.

# ---- Backend (FastAPI, read via pydantic-settings) ----

# SQLite database location. Relative paths are resolved from the backend/ folder.
DEVTRACK_DATABASE_URL=sqlite:///./data/devtrack.db

# Comma-separated browser origins allowed to call the API directly (CORS).
DEVTRACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Load the clearly labelled demo workspace the first time an empty database starts.
DEVTRACK_SEED_DEMO_DATA=true

# ---- Frontend (Vite; only VITE_* values are exposed to browser code) ----

# Where the Vite dev and preview servers forward /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty to go through the Vite proxy (recommended).
# Set to http://127.0.0.1:8000 to call the API directly, which relies on the CORS setting above.
VITE_API_BASE_URL=
