# Normalise line endings so the repository behaves the same on Windows, macOS and Linux.
* text=auto eol=lf

# PowerShell and batch scripts keep Windows line endings.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
